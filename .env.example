# 复制本文件为 .env 后填写真实值（.env 已被 gitignore，永远不要提交）

# Sepolia RPC 地址（公共节点即可，也可换成 Alchemy）
API_URL=https://ethereum-sepolia-rpc.publicnode.com

# 部署账户私钥：0x + 64 位十六进制
PRIVATE_KEY=YOUR_PRIVATE_KEY

# LQYSwap 部署完成后，把打印出的合约地址回填到这里
CONTRACT_ADDRESS=YOUR_CONTRACT_ADDRESS

# LQY 代币地址（lqy-token 项目已部署在 Sepolia）
LQY_ADDRESS=0x32603501302233f4eE2DAbDBeF96EB7951c48aD7

# Etherscan 的 API key（仅验证合约时用）
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
